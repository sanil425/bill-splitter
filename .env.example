ANTHROPIC_API_KEY=
# Optional; both default to claude-sonnet-5-5
ATTRIBUTION_MODEL=
RECEIPT_MODEL=

OPENAI_API_KEY=
# Optional; defaults to gpt-transcribe
TRANSCRIBE_MODEL=

# Required: AI routes refuse requests (503) without Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional rate limits (defaults: 20 AI calls per IP per "10 m", 500 per UTC day overall)
RATE_LIMIT_IP_REQUESTS=
RATE_LIMIT_IP_WINDOW=
RATE_LIMIT_DAILY_CAP=
